---
// «Cómo trabajo»: pagos, puesta en línea, mantenimiento… dentro de un solo panel.
import { comoTrabajo } from "../data/servicios.js";
---

<section class="seccion" id="como-trabajo">
  <div class="contenedor">
    <div class="panel">
      <h2>Cómo trabajo</h2>

      <dl class="puntos">
        {
          comoTrabajo.map((p) => (
            <div>
              <dt>{p.titulo}</dt>
              <dd>{p.texto}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<style>
  .panel {
    padding: 1.75rem 1.25rem;
    border-radius: var(--radio);
    background: var(--panel);
  }

  h2 {
    margin-bottom: 1.5rem;
  }

  .puntos {
    display: grid;
    gap: 1.375rem;
    margin: 0;
  }

  dt {
    font-size: 1.1875rem;
    font-weight: 800;
    margin-bottom: 0.125rem;
  }

  dd {
    margin: 0;
    color: var(--texto-suave);
  }

  @media (min-width: 48rem) {
    .panel {
      padding: 3rem;
    }

    .puntos {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem 3rem;
    }
  }

  @media (min-width: 64rem) {
    .puntos {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
