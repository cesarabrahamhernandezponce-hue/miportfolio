---
// Página única. Cada sección se irá sustituyendo por su componente.
import Base from "../layouts/Base.astro";
import Portada from "../components/Portada.astro";
import { secciones } from "../data/sitio.js";
---

<Base>
  <Portada />

  {
    secciones.map((s) => (
      <section class="seccion" id={s.id}>
        <div class="contenedor">
          <h2>{s.titulo}</h2>
          <p class="hueco">Sección en construcción.</p>
        </div>
      </section>
    ))
  }
</Base>

<style>
  .hueco {
    padding: 1.25rem;
    border-radius: var(--radio);
    background: var(--panel);
    color: var(--texto-suave);
  }
</style>
