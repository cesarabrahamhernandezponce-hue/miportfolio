---
// Página única. Cada sección se irá sustituyendo por su componente.
import Base from "../layouts/Base.astro";
import Portada from "../components/Portada.astro";
import Proyectos from "../components/Proyectos.astro";
import Servicios from "../components/Servicios.astro";
import ComoTrabajo from "../components/ComoTrabajo.astro";
import { secciones } from "../data/sitio.js";
---

<Base>
  <Portada />
  <Proyectos />
  <Servicios />
  <ComoTrabajo />

  {
    secciones.filter((s) => ["habilidades", "contacto"].includes(s.id)).map((s) => (
      <section class="seccion" id={s.id}>
        <div class="contenedor">
          <h2>{s.titulo}</h2>
          <p class="hueco">Sección en construcción.</p>
        </div>
      </section>
    ))
  }
</Base>

<style>
  .hueco {
    padding: 1.25rem;
    border-radius: var(--radio);
    background: var(--panel);
    color: var(--texto-suave);
  }
</style>
